<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerviero Break - Pro Breakout Scanner & Autonomous Paper Bot</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0f172a',
                        cardbg: '#1e293b',
                        bordercol: '#334155',
                        brandblue: '#3b82f6',
                        brandgreen: '#10b981',
                        brandred: '#ef4444'
                    }
                }
            }
        }
    </script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        @keyframes pulse-slow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-slow { animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    </style>
</head>
<body class="bg-darkbg text-slate-100 min-h-screen flex flex-col selection:bg-blue-500 selection:text-white overflow-x-hidden">

    <!-- Top Navigation Header -->
    <header class="bg-cardbg border-b border-bordercol sticky top-0 z-50 px-4 py-3 shadow-lg">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-3">
            <div class="flex items-center space-x-3 w-full md:w-auto">
                <div class="bg-gradient-to-tr from-blue-600 to-indigo-500 p-2.5 rounded-xl shadow-md text-white shrink-0">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight bg-gradient-to-r from-blue-400 to-indigo-300 bg-clip-text text-transparent">Cerviero Break Pro Scanner & Paper Bot</h1>
                    <p class="text-xs text-slate-400">Dynamic Channels, €2,000 Autonomous Demo & Multi-Asset Intelligence</p>
                </div>
            </div>

            <!-- Global Controls & Status -->
            <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto justify-between md:justify-end">
                <!-- Timeframe Selector -->
                <div class="flex items-center bg-slate-900 border border-bordercol rounded-lg p-1 text-xs">
                    <button onclick="setTimeframe('M15')" id="tfM15" class="px-2.5 py-1 rounded transition text-slate-400 font-medium">M15</button>
                    <button onclick="setTimeframe('H1')" id="tfH1" class="px-2.5 py-1 rounded transition bg-blue-600 text-white font-bold">H1</button>
                    <button onclick="setTimeframe('H4')" id="tfH4" class="px-2.5 py-1 rounded transition text-slate-400 font-medium">H4</button>
                    <button onclick="setTimeframe('D1')" id="tfD1" class="px-2.5 py-1 rounded transition text-slate-400 font-medium">D1</button>
                </div>

                <div class="flex items-center bg-slate-900 border border-bordercol rounded-lg px-3 py-1.5 text-xs">
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping mr-2"></span>
                    <span class="text-slate-300 font-medium">Live: <span id="clock" class="text-emerald-400 font-mono">00:00:00</span></span>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="triggerManualScan()" class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-3 py-1.5 rounded-lg text-xs shadow-sm transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate"></i> Scan
                    </button>

                    <button onclick="toggleSound()" id="soundToggleBtn" class="bg-slate-800 hover:bg-slate-700 border border-bordercol text-slate-300 px-3 py-1.5 rounded-lg text-xs transition flex items-center gap-1.5">
                        <i class="fa-solid fa-volume-high text-emerald-400" id="soundIcon"></i> <span id="soundText">Sound On</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

        <!-- DEMO PAPER TRADING ACCOUNT (€2,000) SECTION -->
        <section class="bg-gradient-to-br from-slate-900 via-cardbg to-slate-900 border border-blue-500/30 rounded-2xl p-5 shadow-xl space-y-5">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 border-b border-bordercol pb-4">
                <div class="flex items-center gap-3">
                    <div class="bg-emerald-500/20 border border-emerald-500/30 p-2.5 rounded-xl text-emerald-400 shrink-0">
                        <i class="fa-solid fa-robot text-xl"></i>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-base font-bold text-white">Demo Paper Trading Account (€2,000.00)</h2>
                            <span id="botStatusBadge" class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> Bot Active
                            </span>
                            <span class="bg-blue-500/10 text-blue-300 border border-blue-500/20 px-2 py-0.5 rounded-full text-[10px] font-medium flex items-center gap-1">
                                <i class="fa-solid fa-database text-[9px]"></i> Auto-Saved
                            </span>
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5">Autonomous Cerviero Break execution on Upper/Lower Blue Channels (SL & TP 1:2 RR)</p>
                    </div>
                </div>

                <!-- Bot Controls -->
                <div class="flex flex-wrap items-center gap-2.5 w-full lg:w-auto">
                    <!-- Selective Watchlist Bot Filter Toggle -->
                    <label class="flex items-center gap-2 bg-slate-950 border border-bordercol rounded-lg px-2.5 py-1.5 text-xs cursor-pointer select-none">
                        <i class="fa-solid fa-star text-yellow-400 text-[11px]"></i>
                        <span class="text-slate-300 font-medium">Bot: Watchlist Only</span>
                        <input type="checkbox" id="botWatchlistOnlyToggle" onchange="toggleBotWatchlistOnly()" class="sr-only peer">
                        <div class="w-8 h-4 bg-slate-700 rounded-full peer peer-checked:bg-blue-600 relative after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-4"></div>
                    </label>

                    <div class="flex items-center bg-slate-950 border border-bordercol rounded-lg px-2.5 py-1.5 text-xs">
                        <span class="text-slate-400 mr-1.5">Risk/Trade:</span>
                        <select id="riskPerTrade" onchange="saveStateToStorage()" class="bg-transparent text-white font-bold focus:outline-none cursor-pointer">
                            <option value="0.01" class="bg-slate-900">1% (€20)</option>
                            <option value="0.02" selected class="bg-slate-900">2% (€40)</option>
                            <option value="0.05" class="bg-slate-900">5% (€100)</option>
                        </select>
                    </div>

                    <button onclick="toggleAutoBot()" id="toggleBotBtn" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-3.5 py-1.5 rounded-lg text-xs shadow transition flex items-center gap-1.5">
                        <i class="fa-solid fa-pause" id="botBtnIcon"></i> <span id="botBtnText">Pause Bot</span>
                    </button>

                    <button onclick="requestResetConfirmation()" id="resetDemoBtn" class="bg-slate-800 hover:bg-red-900/50 hover:text-red-300 border border-bordercol text-slate-300 font-medium px-3 py-1.5 rounded-lg text-xs transition flex items-center gap-1.5">
                        <i class="fa-solid fa-arrow-rotate-left"></i> <span id="resetBtnText">Reset €2,000</span>
                    </button>
                </div>
            </div>

            <!-- Account Metrics Grid (8 Cards: Balance, Equity, Floating, Net P&L, Win Rate, Total Trades, Profit Factor, Max Drawdown) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Account Balance</p>
                    <p class="text-base font-bold font-mono text-white mt-0.5" id="demoBalance">€2,000.00</p>
                </div>
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Live Equity</p>
                    <p class="text-base font-bold font-mono text-blue-400 mt-0.5" id="demoEquity">€2,000.00</p>
                </div>
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Floating P&L</p>
                    <p class="text-base font-bold font-mono text-slate-300 mt-0.5" id="demoFloatingPnl">€0.00</p>
                </div>
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Net Realized</p>
                    <p class="text-base font-bold font-mono text-slate-300 mt-0.5" id="demoNetPnl">€0.00</p>
                </div>
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Win Rate %</p>
                    <p class="text-base font-bold font-mono text-emerald-400 mt-0.5" id="demoWinRate">0.0%</p>
                </div>
                <div class="bg-slate-950/70 border border-bordercol rounded-xl p-3">
                    <p class="text-[10px] text-slate-400 uppercase font-semibold tracking-wider">Total Trades</p>
                    <p class="text-base font-bold font-mono text-indigo-400 mt-0.5" id="demoTotalTrades">0 <span class="text-[11px] font-normal text-slate-400">(0W/0L)</span></p>
                </div>
                <div class="bg-slate-950/70 border border-blue-500/20 rounded-xl p-3">
                    <p class="text-[10px] text-blue-300 uppercase font-semibold tracking-wider">Profit Factor</p>
                    <p class="text-base font-bold font-mono text-white mt-0.5" id="demoProfitFactor">0.00</p>
                </div>
                <div class="bg-slate-950/70 border border-red-500/20 rounded-xl p-3">
                    <p class="text-[10px] text-red-300 uppercase font-semibold tracking-wider">Max Drawdown</p>
                    <p class="text-base font-bold font-mono text-red-400 mt-0.5" id="demoMaxDrawdown">0.00%</p>
                </div>
            </div>

            <!-- Open Positions, Closed History & Equity Curve -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <!-- Live Open Positions -->
                <div class="lg:col-span-2 bg-slate-950/60 border border-bordercol rounded-xl p-3.5 flex flex-col">
                    <div class="flex justify-between items-center mb-2.5">
                        <h3 class="text-xs font-bold text-slate-200 flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-yellow-400"></i> Live Open Positions (<span id="openPosCount">0</span>)
                        </h3>
                        <button onclick="closeAllPositions()" class="text-[11px] text-red-400 hover:text-red-300 transition font-medium">Close All</button>
                    </div>
                    <div class="overflow-x-auto flex-grow max-h-52 overflow-y-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="text-slate-400 text-[10px] uppercase border-b border-bordercol">
                                    <th class="py-2 px-2">Asset</th>
                                    <th class="py-2 px-2">Type</th>
                                    <th class="py-2 px-2 text-right">Entry</th>
                                    <th class="py-2 px-2 text-right">Current</th>
                                    <th class="py-2 px-2 text-right">SL / TP</th>
                                    <th class="py-2 px-2 text-right">P&L (€)</th>
                                    <th class="py-2 px-2 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="openPositionsBody" class="divide-y divide-bordercol/50">
                                <tr><td colspan="7" class="py-6 text-center text-slate-500">Scanning Blue Channels for next Cerviero Break entry...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Mini Equity Curve & Closed History -->
                <div class="bg-slate-950/60 border border-bordercol rounded-xl p-3.5 flex flex-col justify-between space-y-3">
                    <div>
                        <div class="flex justify-between items-center mb-1.5">
                            <h3 class="text-xs font-bold text-slate-200 flex items-center gap-1.5">
                                <i class="fa-solid fa-chart-area text-blue-400"></i> Equity Curve (€2,000 Base)
                            </h3>
                            <span class="text-[10px] font-mono text-slate-400" id="equityReturnPct">+0.00%</span>
                        </div>
                        <div class="w-full h-24 bg-slate-900 rounded-lg border border-bordercol overflow-hidden">
                            <canvas id="equityCanvas" class="w-full h-full"></canvas>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-[11px] font-bold text-slate-300 mb-1.5 flex items-center justify-between">
                            <span>Recent Closed Trades</span>
                            <span class="text-[10px] text-slate-500 font-normal">Latest 6</span>
                        </h4>
                        <div id="closedTradesList" class="space-y-1.5 max-h-24 overflow-y-auto text-[11px]">
                            <p class="text-slate-500 text-center py-2">No closed trades yet.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Strategy Parameters & Webhook Simulation Bar -->
        <section class="bg-cardbg border border-bordercol rounded-2xl p-4 shadow-md grid grid-cols-1 lg:grid-cols-3 gap-4 items-center">
            <!-- Channel Parameters -->
            <div>
                <h2 class="text-xs font-semibold text-slate-200 flex items-center gap-2 mb-1.5">
                    <i class="fa-solid fa-sliders text-blue-400"></i> Cerviero Channel Settings
                </h2>
                <div class="flex items-center gap-2.5">
                    <div class="flex items-center space-x-1.5 bg-slate-900 px-2.5 py-1 rounded-lg border border-bordercol text-xs">
                        <span class="text-slate-400">Pivot:</span>
                        <input type="number" id="inputPivot" value="20" min="5" max="100" class="w-12 bg-slate-800 text-white font-mono font-bold text-center rounded border border-slate-700 py-0.5">
                    </div>
                    <div class="flex items-center space-x-1.5 bg-slate-900 px-2.5 py-1 rounded-lg border border-bordercol text-xs">
                        <span class="text-slate-400">Mult:</span>
                        <input type="number" id="inputMult" value="3.0" step="0.5" min="1" max="10" class="w-12 bg-slate-800 text-white font-mono font-bold text-center rounded border border-slate-700 py-0.5">
                    </div>
                    <button onclick="applyParameters()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition">Apply</button>
                </div>
            </div>

            <!-- Watchlist Management Bar -->
            <div class="border-t lg:border-t-0 lg:border-x border-bordercol pt-3 lg:pt-0 lg:px-4 space-y-2">
                <h2 class="text-xs font-semibold text-slate-200 flex items-center gap-2">
                    <i class="fa-solid fa-star text-yellow-400"></i> Watchlist Management
                </h2>
                <div class="flex items-center justify-between bg-slate-900 px-3 py-1.5 rounded-lg border border-bordercol text-xs">
                    <span class="text-slate-300">Show Watchlist Only (Table)</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="watchlistToggle" onchange="toggleWatchlistFilter()" class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                </div>
            </div>

            <!-- Telegram / Discord Webhook Simulation -->
            <div class="border-t lg:border-t-0 border-bordercol pt-3 lg:pt-0">
                <h2 class="text-xs font-semibold text-slate-200 flex items-center gap-2 mb-1.5">
                    <i class="fa-brands fa-telegram text-sky-400"></i> Instant Webhook Broadcast
                </h2>
                <div class="flex items-center gap-2">
                    <input type="text" id="webhookUrlInput" value="https://api.telegram.org/bot-sim/sendCervieroBreakAlert" class="bg-slate-900 border border-bordercol text-slate-300 text-xs rounded-lg px-3 py-1.5 flex-grow font-mono focus:outline-none focus:border-blue-500">
                    <button onclick="testWebhookBroadcast()" class="bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold px-3.5 py-1.5 rounded-lg transition shadow flex items-center gap-1.5 whitespace-nowrap">
                        <i class="fa-solid fa-paper-plane"></i> Test Bot
                    </button>
                </div>
            </div>
        </section>

        <!-- Stats Overview Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-cardbg border border-bordercol rounded-2xl p-4 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active TF</p>
                    <h3 class="text-2xl font-bold text-slate-100 mt-1" id="statTimeframe">H1</h3>
                    <p class="text-xs text-blue-400 mt-1"><i class="fa-solid fa-clock"></i> Dynamic Slope Active</p>
                </div>
                <div class="bg-blue-500/10 p-3 rounded-xl text-blue-400">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
            </div>
            <div class="bg-cardbg border border-bordercol rounded-2xl p-4 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active BUY Signals</p>
                    <h3 class="text-2xl font-bold text-emerald-400 mt-1" id="statBuyCount">0</h3>
                    <p class="text-xs text-emerald-500 mt-1"><i class="fa-solid fa-arrow-trend-up"></i> Above Upper Channel</p>
                </div>
                <div class="bg-emerald-500/10 p-3 rounded-xl text-emerald-400">
                    <i class="fa-solid fa-circle-check text-xl"></i>
                </div>
            </div>
            <div class="bg-cardbg border border-bordercol rounded-2xl p-4 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active SELL Signals</p>
                    <h3 class="text-2xl font-bold text-red-400 mt-1" id="statSellCount">0</h3>
                    <p class="text-xs text-red-500 mt-1"><i class="fa-solid fa-arrow-trend-down"></i> Below Lower Channel</p>
                </div>
                <div class="bg-red-500/10 p-3 rounded-xl text-red-400">
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>
            </div>
            <div class="bg-cardbg border border-bordercol rounded-2xl p-4 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400 uppercase tracking-wider">XAUUSD Target (3917)</p>
                    <h3 class="text-xl font-bold text-indigo-400 mt-1" id="statGoldDist">-- USD</h3>
                    <p class="text-xs text-indigo-300 mt-1" id="statGoldStatus">Distance to Key Level</p>
                </div>
                <div class="bg-indigo-500/10 p-3 rounded-xl text-indigo-400">
                    <i class="fa-solid fa-bullseye text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Main Workspace Grid (Scanner Table + Distancemeter & Chart & Alerts) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Left 2 Columns: Asset Scanner Table -->
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-cardbg border border-bordercol rounded-2xl shadow-md overflow-hidden">
                    <div class="p-4 border-b border-bordercol flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                                <i class="fa-solid fa-table-list text-blue-400"></i> Universal Asset Breakout Scanner
                            </h3>
                            <p class="text-xs text-slate-400">Click star to add to Watchlist. Click asset to inspect chart & Distancemeter.</p>
                        </div>
                        <div class="flex items-center space-x-2 w-full sm:w-auto">
                            <select id="filterCategory" onchange="renderTable()" class="bg-slate-900 border border-bordercol text-slate-300 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-blue-500 w-full sm:w-auto">
                                <option value="ALL">All Categories (20 Assets)</option>
                                <option value="Forex">Forex Majors & Minors (10)</option>
                                <option value="Commodity">Commodities (Gold, Silver, Oil)</option>
                                <option value="Crypto">Crypto (BTC, ETH, SOL)</option>
                                <option value="Stock">Indices & Stocks</option>
                            </select>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-900/60 text-slate-400 text-xs font-semibold uppercase tracking-wider border-b border-bordercol">
                                    <th class="py-3 px-3 text-center">⭐</th>
                                    <th class="py-3 px-3">Symbol & Asset</th>
                                    <th class="py-3 px-3 text-right">Live Price</th>
                                    <th class="py-3 px-3 text-center">Status</th>
                                    <th class="py-3 px-3 text-right">Upper Blue</th>
                                    <th class="py-3 px-3 text-right">Lower Blue</th>
                                    <th class="py-3 px-3 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="assetTableBody" class="divide-y divide-bordercol text-xs">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right 1 Column: Distancemeter, Chart Visualizer & Live Alert Feed -->
            <div class="space-y-6">

                <!-- Distancemeter Panel -->
                <div class="bg-cardbg border border-bordercol rounded-2xl shadow-md p-4">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-gauge-high text-emerald-400"></i> Distancemeter (<span id="distAssetTitle">XAUUSD</span>)
                        </h3>
                        <span class="text-[11px] text-slate-400 font-mono">Key Target: <strong class="text-indigo-400" id="distKeyTarget">3917.37</strong></span>
                    </div>
                    <div class="bg-slate-900 p-3 rounded-xl border border-bordercol space-y-3">
                        <div class="flex justify-between text-xs">
                            <span class="text-slate-400">Distance to Upper Level:</span>
                            <span class="font-mono font-bold text-blue-400" id="distUpperVal">-- pips (--%)</span>
                        </div>
                        <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
