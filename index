        function openDemoPosition(asset, side) {
            if (!demoAccount.botActive) return;
            // Respect Selective Watchlist Bot Filter
            if (botWatchlistOnly && !asset.isWatchlist) return;
            // Prevent duplicate position on same asset
            if (demoAccount.openPositions.some(p => p.assetId === asset.id)) return;
            // Max 6 concurrent trades to manage margin
            if (demoAccount.openPositions.length >= 6) return;

            const riskPct = parseFloat(document.getElementById('riskPerTrade').value) || 0.02;
            const riskEuro = demoAccount.balance * riskPct;
            const channelHeight = Math.abs(asset.upperLine - asset.lowerLine);
            const slDistance = channelHeight * 0.45; // Structural SL inside channel
            const tpDistance = slDistance * 2.0;     // 1:2 Risk-to-Reward ratio

            const entryPrice = asset.price;
            const slPrice = side === 'BUY' ? entryPrice - slDistance : entryPrice + slDistance;
            const tpPrice = side === 'BUY' ? entryPrice + tpDistance : entryPrice - tpDistance;

            const pos = {
                id: 'TRD-' + Math.floor(1000 + Math.random() * 9000),
                assetId: asset.id,
                symbol: asset.name,
                side: side,
                entry: entryPrice,
                sl: slPrice,
                tp: tpPrice,
                slDistance: slDistance,
                riskEuro: riskEuro,
                pnl: 0,
                openTime: new Date().toTimeString().split(' ')[0]
            };

            demoAccount.openPositions.push(pos);
            const dot = side === 'BUY' ? '🟢' : '🔴';
            pushAlert(asset.name, side, `${dot} AUTO-TRADE OPENED: ${side} ${asset.name} @ ${formatPrice(entryPrice, asset.name)} (Risk: €${riskEuro.toFixed(2)})`);
            updateDemoDashboard();
            saveStateToStorage();
        }

        function closeDemoPosition(posId, reason = 'Manual') {
            const idx = demoAccount.openPositions.findIndex(p => p.id === posId);
            if (idx === -1) return;

            const pos = demoAccount.openPositions[idx];
            demoAccount.openPositions.splice(idx, 1);

            demoAccount.balance += pos.pnl;
            demoAccount.equityHistory.push(demoAccount.balance);
            if (demoAccount.equityHistory.length > 40) demoAccount.equityHistory.shift();

            // Update Peak Equity & Max Drawdown %
            if (demoAccount.balance > demoAccount.peakEquity) {
                demoAccount.peakEquity = demoAccount.balance;
            }
            const currentDdPct = ((demoAccount.peakEquity - demoAccount.balance) / demoAccount.peakEquity) * 100;
            if (currentDdPct > demoAccount.maxDrawdownPct) {
                demoAccount.maxDrawdownPct = currentDdPct;
            }

            // Update Gross Profit / Gross Loss & Win/Loss Counts
            if (pos.pnl >= 0) {
                demoAccount.wins++;
                demoAccount.grossProfit += pos.pnl;
            } else {
                demoAccount.losses++;
                demoAccount.grossLoss += Math.abs(pos.pnl);
            }

            demoAccount.closedTrades.unshift({
                symbol: pos.symbol,
                side: pos.side,
                pnl: pos.pnl,
                reason: reason,
                time: new Date().toTimeString().split(' ')[0]
            });
            if (demoAccount.closedTrades.length > 30) demoAccount.closedTrades.pop();

            const resIcon = pos.pnl >= 0 ? '✅' : '❌';
            pushAlert(pos.symbol, pos.pnl >= 0 ? 'BUY' : 'SELL', `${resIcon} TRADE CLOSED (${reason}): ${pos.symbol} ${pos.side} | P&L: ${pos.pnl >= 0 ? '+' : ''}€${pos.pnl.toFixed(2)}`);
            updateDemoDashboard();
            saveStateToStorage();
        }

        function closeAllPositions() {
            const ids = demoAccount.openPositions.map(p => p.id);
            ids.forEach(id => closeDemoPosition(id, 'Close All'));
        }

        function evaluateOpenPositions() {
            let totalFloating = 0;
            const toClose = [];

            demoAccount.openPositions.forEach(pos => {
                const asset = assetsData.find(a => a.id === pos.assetId);
                if (!asset) return;

                const priceDiff = pos.side === 'BUY' ? (asset.price - pos.entry) : (pos.entry - asset.price);
                pos.pnl = (priceDiff / pos.slDistance) * pos.riskEuro;
                totalFloating += pos.pnl;

                if (pos.side === 'BUY') {
                    if (asset.price >= pos.tp) toClose.push({ id: pos.id, reason: 'Take Profit 🎯' });
                    else if (asset.price <= pos.sl) toClose.push({ id: pos.id, reason: 'Stop Loss 🛑' });
                } else {
                    if (asset.price <= pos.tp) toClose.push({ id: pos.id, reason: 'Take Profit 🎯' });
                    else if (asset.price >= pos.sl) toClose.push({ id: pos.id, reason: 'Stop Loss 🛑' });
                }
            });

            toClose.forEach(item => closeDemoPosition(item.id, item.reason));
            updateDemoDashboard(totalFloating);
        }

        function updateDemoDashboard(floatingPnl = null) {
            if (floatingPnl === null) {
                floatingPnl = demoAccount.openPositions.reduce((sum, p) => sum + p.pnl, 0);
            }

            const equity = demoAccount.balance + floatingPnl;
            // Track intraday floating drawdown if equity dips below peak
            if (equity > demoAccount.peakEquity) {
                demoAccount.peakEquity = equity;
            }
            const liveDdPct = ((demoAccount.peakEquity - equity) / demoAccount.peakEquity) * 100;
            if (liveDdPct > demoAccount.maxDrawdownPct) {
                demoAccount.maxDrawdownPct = liveDdPct;
            }

            const netPnl = demoAccount.balance - INITIAL_CAPITAL;
            const totalTrades = demoAccount.wins + demoAccount.losses;
            const winRate = totalTrades > 0 ? ((demoAccount.wins / totalTrades) * 100).toFixed(1) : '0.0';
            const returnPct = ((equity - INITIAL_CAPITAL) / INITIAL_CAPITAL) * 100;

            // Profit Factor Calculation
            let pfText = '0.00';
            let pfColor = 'text-slate-300';
            if (demoAccount.grossLoss > 0) {
                const pfVal = demoAccount.grossProfit / demoAccount.grossLoss;
                pfText = pfVal.toFixed(2);
                pfColor = pfVal >= 1.5 ? 'text-emerald-400' : (pfVal >= 1.0 ? 'text-blue-400' : 'text-red-400');
            } else if (demoAccount.grossProfit > 0) {
                pfText = '∞';
                pfColor = 'text-emerald-400';
            }

            document.getElementById('demoBalance').innerText = `€${demoAccount.balance.toFixed(2)}`;
            document.getElementById('demoEquity').innerText = `€${equity.toFixed(2)}`;

            const floatEl = document.getElementById('demoFloatingPnl');
            floatEl.innerText = `${floatingPnl >= 0 ? '+' : ''}€${floatingPnl.toFixed(2)}`;
            floatEl.className = `text-base font-bold font-mono mt-0.5 ${floatingPnl > 0 ? 'text-emerald-400' : (floatingPnl < 0 ? 'text-red-400' : 'text-slate-300')}`;

            const netEl = document.getElementById('demoNetPnl');
            netEl.innerText = `${netPnl >= 0 ? '+' : ''}€${netPnl.toFixed(2)}`;
            netEl.className = `text-base font-bold font-mono mt-0.5 ${netPnl > 0 ? 'text-emerald-400' : (netPnl < 0 ? 'text-red-400' : 'text-slate-300')}`;

            document.getElementById('demoWinRate').innerText = `${winRate}%`;
            document.getElementById('demoTotalTrades').innerHTML = `${totalTrades} <span class="text-[11px] font-normal text-slate-400">(${demoAccount.wins}W/${demoAccount.losses}L)</span>`;

            const pfEl = document.getElementById('demoProfitFactor');
            pfEl.innerText = pfText;
            pfEl.className = `text-base font-bold font-mono mt-0.5 ${pfColor}`;

            document.getElementById('demoMaxDrawdown').innerText = `${demoAccount.maxDrawdownPct.toFixed(2)}%`;
            document.getElementById('openPosCount').innerText = demoAccount.openPositions.length;

            const retEl = document.getElementById('equityReturnPct');
            retEl.innerText = `${returnPct >= 0 ? '+' : ''}${returnPct.toFixed(2)}%`;
            retEl.className = `text-[10px] font-mono font-bold ${returnPct >= 0 ? 'text-emerald-400' : 'text-red-400'}`;

            // Render Open Positions Table
            const tbody = document.getElementById('openPositionsBody');
            if (demoAccount.openPositions.length === 0) {
                const scopeNote = botWatchlistOnly ? 'starred Watchlist assets' : 'all 20 assets';
                tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-slate-500">Scanning Blue Channels across ${scopeNote} for next breakout...</td></tr>`;
            } else {
                tbody.innerHTML = '';
                demoAccount.openPositions.forEach(pos => {
                    const asset = assetsData.find(a => a.id === pos.assetId);
                    const curPrice = asset ? asset.price : pos.entry;
                    const sideBadge = pos.side === 'BUY'
                        ? `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded font-bold whitespace-nowrap">BUY 🟢</span>`
                        : `<span class="bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded font-bold whitespace-nowrap">SELL 🔴</span>`;
                    const pnlColor = pos.pnl >= 0 ? 'text-emerald-400' : 'text-red-400';

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-900/50 transition';
                    tr.innerHTML = `
                        <td class="py-2 px-2 font-bold text-white">${pos.symbol}</td>
                        <td class="py-2 px-2">${sideBadge}</td>
                        <td class="py-2 px-2 text-right font-mono text-slate-300">${formatPrice(pos.entry, pos.symbol)}</td>
                        <td class="py-2 px-2 text-right font-mono text-white">${formatPrice(curPrice, pos.symbol)}</td>
                        <td class="py-2 px-2 text-right font-mono text-[10px] text-slate-400 whitespace-nowrap">
                            <span class="text-red-400">${formatPrice(pos.sl, pos.symbol)}</span> / <span class="text-emerald-400">${formatPrice(pos.tp, pos.symbol)}</span>
                        </td>
                        <td class="py-2 px-2 text-right font-mono font-bold ${pnlColor} whitespace-nowrap">${pos.pnl >= 0 ? '+' : ''}€${pos.pnl.toFixed(2)}</td>
                        <td class="py-2 px-2 text-center">
                            <button onclick="closeDemoPosition('${pos.id}', 'Manual')" class="bg-slate-800 hover:bg-red-600 text-slate-300 hover:text-white px-2 py-0.5 rounded text-[10px] transition">Close</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            // Render Closed History
            const closedDiv = document.getElementById('closedTradesList');
            if (demoAccount.closedTrades.length === 0) {
                closedDiv.innerHTML = `<p class="text-slate-500 text-center py-2">No closed trades yet.</p>`;
            } else {
                closedDiv.innerHTML = '';
                demoAccount.closedTrades.slice(0, 6).forEach(tr => {
                    const color = tr.pnl >= 0 ? 'text-emerald-400' : 'text-red-400';
                    const dot = tr.side === 'BUY' ? '🟢' : '🔴';
                    const row = document.createElement('div');
                    row.className = 'flex justify-between items-center bg-slate-900/80 px-2.5 py-1.5 rounded border border-bordercol/60';
                    row.innerHTML = `
                        <span class="font-semibold text-slate-200">${dot} ${tr.symbol} <span class="text-[9px] text-slate-400 font-normal">(${tr.reason})</span></span>
                        <span class="font-mono font-bold ${color}">${tr.pnl >= 0 ? '+' : ''}€${tr.pnl.toFixed(2)}</span>
                    `;
                    closedDiv.appendChild(row);
                });
            }

            drawEquityCurve();
        }

        // --- Mini Equity Curve Canvas ---
        let eqCanvas, eqCtx;
        function initEquityCanvas() {
            eqCanvas = document.getElementById('equityCanvas');
            if (!eqCanvas) return;
            eqCtx = eqCanvas.getContext('2d');
            resizeEquityCanvas();
            window.addEventListener('resize', () => {
                resizeEquityCanvas();
                drawEquityCurve();
            });
        }

        function resizeEquityCanvas() {
            if (!eqCanvas) return;
            const parent = eqCanvas.parentElement;
            eqCanvas.width = parent.clientWidth;
            eqCanvas.height = parent.clientHeight;
        }

        function drawEquityCurve() {
            if (!eqCtx || !eqCanvas) return;
            const w = eqCanvas.width;
            const h = eqCanvas.height;
            eqCtx.clearRect(0, 0, w, h);

            const pts = [...demoAccount.equityHistory];
            const floating = demoAccount.openPositions.reduce((s, p) => s + p.pnl, 0);
            pts.push(demoAccount.balance + floating);

            const minVal = Math.min(...pts, INITIAL_CAPITAL * 0.99);
            const maxVal = Math.max(...pts, INITIAL_CAPITAL * 1.01);
            const range = (maxVal - minVal) || 1;

            const scaleY = (v) => h - ((v - minVal) / range) * (h - 16) - 8;

            // Baseline €2,000 dashed
            const baseY = scaleY(INITIAL_CAPITAL);
            eqCtx.strokeStyle = 'rgba(148, 163, 184, 0.3)';
            eqCtx.setLineDash([3, 3]);
            eqCtx.beginPath();
            eqCtx.moveTo(0, baseY);
            eqCtx.lineTo(w, baseY);
            eqCtx.stroke();
            eqCtx.setLineDash([]);

            // Equity line
            const lastVal = pts[pts.length - 1];
            eqCtx.strokeStyle = lastVal >= INITIAL_CAPITAL ? '#10b981' : '#ef4444';
            eqCtx.lineWidth = 2;
            eqCtx.beginPath();
            pts.forEach((val, i) => {
                const x = pts.length === 1 ? w / 2 : (i / (pts.length - 1)) * w;
                const y = scaleY(val);
                if (i === 0) eqCtx.moveTo(x, y);
                else eqCtx.lineTo(x, y);
            });
            eqCtx.stroke();
        }

        // --- Ticks & Autonomous Breakout Execution ---
        function simulateMarketTick() {
            for (let k = 0; k < 4; k++) {
                const index = Math.floor(Math.random() * assetsData.length);
                const asset = assetsData[index];

                let volatility = asset.category === 'Crypto' ? 0.0055 : (asset.category === 'Commodity' ? 0.0042 : 0.0030);
                let change = (Math.random() - 0.49) * (asset.price * volatility);
                asset.prevPrice = asset.price;
                asset.price += change;

                if (asset.price > asset.upperLine && asset.action !== 'BUY') {
                    asset.action = 'BUY';
                    asset.status = 'Bullish';
                    pushAlert(asset.name, 'BUY', `🟢 ${asset.name} (${currentTimeframe}) broke Upper Blue Line (${formatPrice(asset.upperLine, asset.name)})`);
                    openDemoPosition(asset, 'BUY');
                } else if (asset.price < asset.lowerLine && asset.action !== 'SELL') {
                    asset.action = 'SELL';
                    asset.status = 'Bearish';
                    pushAlert(asset.name, 'SELL', `🔴 ${asset.name} (${currentTimeframe}) broke Lower Blue Line (${formatPrice(asset.lowerLine, asset.name)})`);
                    openDemoPosition(asset, 'SELL');
                } else if (asset.price <= asset.upperLine && asset.price >= asset.lowerLine && asset.action !== 'HOLD') {
                    asset.action = 'HOLD';
                    asset.status = 'Consolidating';
                }
            }

            evaluateOpenPositions();
            renderTable();
            updateDistancemeter();
            updateChartInfo();
            drawChart();
        }

        function triggerManualScan() {
            assetsData.forEach(asset => {
                let roll = Math.random();
                if (roll > 0.82) {
                    asset.price = asset.upperLine * 1.0012;
                    asset.action = 'BUY';
                    asset.status = 'Bullish';
                    pushAlert(asset.name, 'BUY', `🟢 Scan confirmed Bullish Cerviero Break on ${asset.name}`);
                    openDemoPosition(asset, 'BUY');
                } else if (roll < 0.18) {
                    asset.price = asset.lowerLine * 0.9988;
                    asset.action = 'SELL';
                    asset.status = 'Bearish';
                    pushAlert(asset.name, 'SELL', `🔴 Scan confirmed Bearish Cerviero Break on ${asset.name}`);
                    openDemoPosition(asset, 'SELL');
                }
            });
            evaluateOpenPositions();
            renderTable();
            updateDistancemeter();
            updateChartInfo();
            drawChart();
            saveStateToStorage();
        }

        // --- Distancemeter Logic ---
        function updateDistancemeter() {
            const asset = assetsData.find(a => a.id === selectedAssetId);
            if (!asset) return;

            document.getElementById('distAssetTitle').innerText = asset.name;
            document.getElementById('distKeyTarget').innerText = formatPrice(asset.keyTarget, asset.name);
            document.getElementById('distCurrentPrice').innerText = formatPrice(asset.price, asset.name);

            let diff = asset.keyTarget - asset.price;
            let percent = (Math.abs(diff) / asset.price) * 100;
            let pips = asset.name.includes('USD') && asset.price < 5 ? (diff * 10000).toFixed(1) : (diff).toFixed(2);

            document.getElementById('distUpperVal').innerText = `${pips} pips (${percent.toFixed(2)}%)`;

            let progress = Math.max(0, Math.min(100, 100 - (percent * 15)));
            document.getElementById('distProgressBar').style.width = progress + '%';

            const statusText = document.getElementById('distStatusText');
            if (Math.abs(percent) < 0.5) {
                statusText.innerText = '🎯 AT KEY BREAKOUT ZONE!';
                statusText.className = 'text-emerald-400 font-bold animate-pulse';
            } else {
                statusText.innerText = diff > 0 ? 'Approaching Resistance' : 'Approaching Support';
                statusText.className = 'text-blue-400 font-medium';
            }

            // Stat Card update for Gold
            const gold = assetsData.find(a => a.id === 'xauusd');
            if (gold) {
                let goldDiff = gold.keyTarget - gold.price;
                let goldPips = (goldDiff).toFixed(1);
                document.getElementById('statGoldDist').innerText = `${goldPips} USD`;
                document.getElementById('statGoldStatus').innerText = goldDiff > 0 ? 'Below 3917 Target' : 'Above 3917 Target';
            }
        }

        // --- Parameters & Stats ---
        function applyParameters() {
            pivotSetting = parseInt(document.getElementById('inputPivot').value) || 20;
            multSetting = parseFloat(document.getElementById('inputMult').value) || 3.0;

            document.getElementById('lblPivot').innerText = pivotSetting;
            document.getElementById('lblMult').innerText = multSetting.toFixed(1);

            assetsData.forEach(asset => {
                let range = asset.price * 0.025 * (multSetting / 3.0);
                asset.upperLine = asset.price + range;
                asset.lowerLine = asset.price - range;
                asset.action = 'HOLD';
                asset.status = 'Consolidating';
            });

            renderTable();
            updateDistancemeter();
            updateChartInfo();
            drawChart();
            pushAlert('SYSTEM', 'INFO', `Recalculated TF ${currentTimeframe} Cerviero channels (Pivot: ${pivotSetting}, Mult: ${multSetting})`);
            saveStateToStorage();
        }

        function updateStats() {
            let buys = assetsData.filter(a => a.action === 'BUY').length;
            let sells = assetsData.filter(a => a.action === 'SELL').length;

            document.getElementById('statBuyCount').innerText = buys;
            document.getElementById('statSellCount').innerText = sells;
        }

        // --- Webhook Simulation ---
        function testWebhookBroadcast() {
            pushAlert('BOT', 'WEBHOOK', `Successfully broadcasted active Cerviero Break signals to Telegram/Discord endpoint.`);
        }

        // --- Alert Feed ---
        function pushAlert(symbol, action, text) {
            const now = new Date().toTimeString().split(' ')[0];
            alertLog.unshift({ time: now, symbol: symbol, action: action, text: text });
            if (alertLog.length > 20) alertLog.pop();
            renderAlertFeed();
            updateStats();
            if (soundEnabled) playBeep();
        }

        function renderAlertFeed() {
            const container = document.getElementById('alertFeedContainer');
            container.innerHTML = '';
            alertLog.forEach(alert => {
                let badgeColor = alert.action === 'BUY' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : (alert.action === 'SELL' ? 'bg-red-500/20 text-red-400 border-red-500/30' : 'bg-blue-500/20 text-blue-400 border-blue-500/30');

                const div = document.createElement('div');
                div.className = 'bg-slate-900 border border-bordercol rounded-xl p-2.5 flex items-start space-x-3 text-xs';
                div.innerHTML = `
                    <span class="px-2 py-0.5 rounded font-bold border ${badgeColor} shrink-0">${alert.action}</span>
                    <div class="flex-grow min-w-0">
                        <div class="flex justify-between items-center">
                            <strong class="text-slate-200">${alert.symbol}</strong>
                            <span class="text-[10px] text-slate-400 font-mono">${alert.time}</span>
                        </div>
                        <p class="text-slate-300 mt-0.5 break-words">${alert.text}</p>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function clearAlerts() {
            alertLog = [];
            renderAlertFeed();
            saveStateToStorage();
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('soundIcon');
            const text = document.getElementById('soundText');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high text-emerald-400';
                text.innerText = 'Sound On';
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-red-400';
                text.innerText = 'Sound Off';
            }
        }

        function playBeep() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.value = 880;
                gain.gain.setValueAtTime(0.08, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.00001, ctx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.25);
            } catch (e) {}
        }

        // --- Canvas Chart ---
        let canvas, ctx;

        function initCanvas() {
            canvas = document.getElementById('channelCanvas');
            ctx = canvas.getContext('2d');
            resizeCanvas();
            window.addEventListener('resize', () => {
                resizeCanvas();
                drawChart();
            });
        }

        function resizeCanvas() {
            if (!canvas) return;
            const container = canvas.parentElement;
            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;
        }

        function updateChartInfo() {
            const asset = assetsData.find(a => a.id === selectedAssetId);
            if (!asset) return;

            document.getElementById('chartSymbolTitle').innerText = asset.name;
            document.getElementById('chartCurrentPrice').innerText = formatPrice(asset.price, asset.name);
            document.getElementById('chartUpperLine').innerText = formatPrice(asset.upperLine, asset.name);
            document.getElementById('chartLowerLine').innerText = formatPrice(asset.lowerLine, asset.name);

            const badge = document.getElementById('chartStatusBadge');
            if (asset.action === 'BUY') {
                badge.className = 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-0.5 rounded-full text-xs font-semibold';
                badge.innerText = 'BULLISH BREAKOUT';
            } else if (asset.action === 'SELL') {
                badge.className = 'bg-red-500/10 text-red-400 border border-red-500/20 px-2.5 py-0.5 rounded-full text-xs font-semibold';
                badge.innerText = 'BEARISH BREAKDOWN';
            } else {
                badge.className = 'bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2.5 py-0.5 rounded-full text-xs font-semibold';
                badge.innerText = 'CONSOLIDATING';
            }
        }

        function drawChart() {
            if (!ctx || !canvas) return;
            const asset = assetsData.find(a => a.id === selectedAssetId);
            if (!asset) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const width = canvas.width;
            const height = canvas.height;

            let points = [];
            let p = asset.price * 0.992;
            for (let i = 0; i < 30; i++) {
                p += (Math.sin(i * 0.4) * (asset.price * 0.0025)) + ((Math.random() - 0.48) * (asset.price * 0.0015));
                points.push(p);
            }
            points[points.length - 1] = asset.price;

            const minP = Math.min(...points, asset.lowerLine) * 0.999;
            const maxP = Math.max(...points, asset.upperLine) * 1.001;
            const rangeP = maxP - minP;

            function scaleY(val) {
                return height - ((val - minP) / rangeP) * (height - 25) - 12;
            }

            const upperY = scaleY(asset.upperLine);
            const lowerY = scaleY(asset.lowerLine);
            const midY = (upperY + lowerY) / 2;

            ctx.fillStyle = 'rgba(59, 130, 246, 0.06)';
            ctx.fillRect(0, upperY, width, lowerY - upperY);

            // Upper Blue Line
            ctx.strokeStyle = '#3b82f6';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, upperY - 8);
            ctx.lineTo(width, upperY + 8);
            ctx.stroke();

            // Lower Blue Line
            ctx.beginPath();
            ctx.moveTo(0, lowerY + 8);
            ctx.lineTo(width, lowerY - 8);
            ctx.stroke();

            // Center Ref Line
            ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
            ctx.setLineDash([3, 3]);
            ctx.beginPath();
            ctx.moveTo(0, midY);
            ctx.lineTo(width, midY);
            ctx.stroke();
            ctx.setLineDash([]);

            // Price Line
            const step = width / points.length;
            ctx.strokeStyle = asset.price >= asset.prevPrice ? '#10b981' : '#ef4444';
            ctx.lineWidth = 2;
            ctx.beginPath();
            points.forEach((pt, idx) => {
                const x = idx * step + step / 2;
                const y = scaleY(pt);
                if (idx === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });
            ctx.stroke();

            // Current Dot
            const lastX = width - step / 2;
            const lastY = scaleY(asset.price);
            ctx.fillStyle = asset.action === 'BUY' ? '#10b981' : (asset.action === 'SELL' ? '#ef4444' : '#3b82f6');
            ctx.beginPath();
            ctx.arc(lastX, lastY, 4.5, 0, Math.PI * 2);
            ctx.fill();
        }
